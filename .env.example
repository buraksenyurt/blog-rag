# LM Studio (OpenAI uyumlu API)
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LLM_MODEL=meta-llama-3-8b-instruct

# Embedding: embedding_profiles.yaml içindeki profil adı (boş bırakılırsa dosyadaki "active" kullanılır)
EMBEDDING_PROFILE=embeddinggemma

# Kaynak yazılar (SALT OKUNUR)
POSTS_DIR=../buraksenyurt.github.io/_posts
EXCLUDE_CATEGORIES=["Foto İpucu"]

# Veritabanları
QDRANT_URL=http://localhost:6333

# Ara çıktılar (git'e girmez)
DATA_DIR=data
